{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AtlasSesIdentityManagement",
      "Effect": "Allow",
      "Action": [
        "ses:CreateEmailIdentity",
        "ses:GetEmailIdentity",
        "ses:PutEmailIdentityDkimAttributes",
        "ses:PutEmailIdentityDkimSigningAttributes",
        "ses:PutEmailIdentityMailFromAttributes",
        "ses:TagResource"
      ],
      "Resource": "arn:aws:ses:eu-central-1:389642461729:identity/*"
    },
    {
      "Sid": "AtlasSesAccountRead",
      "Effect": "Allow",
      "Action": [
        "ses:GetAccount",
        "ses:ListEmailIdentities",
        "ses:ListConfigurationSets",
        "ses:GetSendQuota",
        "ses:PutAccountDetails"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AtlasSesSend",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "arn:aws:ses:eu-central-1:389642461729:identity/helloatlas.dk",
      "Condition": {
        "StringLike": { "ses:FromAddress": "contact@helloatlas.dk" }
      }
    },
    {
      "Sid": "AtlasS3Buckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:PutBucketPolicy",
        "s3:GetBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::atlas-mail-attachments-389642461729",
        "arn:aws:s3:::atlas-releases-389642461729"
      ]
    },
    {
      "Sid": "AtlasS3Objects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::atlas-mail-attachments-389642461729/*",
        "arn:aws:s3:::atlas-releases-389642461729/*"
      ]
    }
  ]
}
