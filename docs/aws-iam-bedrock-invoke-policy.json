{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AtlasBedrockInvokeEeaProfiles",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "arn:aws:bedrock:eu-central-1:389642461729:inference-profile/eu.anthropic.claude-*"
    },
    {
      "Sid": "AtlasBedrockInvokeGlobalProfiles",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "arn:aws:bedrock:us-east-1:389642461729:inference-profile/global.anthropic.claude-*"
    },
    {
      "Sid": "AtlasBedrockInvokeUnderlyingFoundationModels",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "arn:aws:bedrock:*::foundation-model/anthropic.*"
    },
    {
      "Sid": "AtlasBedrockDiscovery",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListInferenceProfiles",
        "bedrock:GetInferenceProfile",
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel"
      ],
      "Resource": "*"
    }
  ]
}
