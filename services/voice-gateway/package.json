{
  "name": "atlas-voice-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas local voice gateway — duplex voice loop (VAD, realtime STT, streaming TTS, barge-in) as a Tauri sidecar. Transport-agnostic core; runs standalone in dev.",
  "scripts": {
    "dev": "bun run src/index.ts",
    "fetch-models": "bun run scripts/fetch-models.ts",
    "typecheck": "bunx tsc --noEmit",
    "bench": "bun run bench/latency.ts",
    "compile": "bun build --compile --minify src/index.ts --outfile dist/atlas-voice-gateway"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "onnxruntime-node": "^1.20.1",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ]
}
